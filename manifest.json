{
  "manifest_version": 3,
  "name": "TruthLens",
  "version": "1.0.4",
  "description": "Helps you evaluate news sources and article transparency.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "action": {
    "default_title": "Analyze this article",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/truthlens-icon-16.png",
      "32": "icons/truthlens-icon-32.png",
      "48": "icons/truthlens-icon-48.png",
      "128": "icons/truthlens-icon-128.png"
    }
  },
  "icons": {
    "16": "icons/truthlens-icon-16.png",
    "32": "icons/truthlens-icon-32.png",
    "48": "icons/truthlens-icon-48.png",
    "128": "icons/truthlens-icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
